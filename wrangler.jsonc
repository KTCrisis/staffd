// Cloudflare Workers — one Worker per environment, same code.
//   staging    → Worker "staffd-staging", built from `main`, Supabase preprod + fixtures
//   cabinet    → Worker "staffd-cabinet", built from `release/cabinet`, its own Supabase
//
// NEXT_PUBLIC_* values are inlined by `next build`, never set here. Deploy with
// `npm run cf:deploy:<env>` (scripts/cf-deploy.sh): it builds with that env's
// Supabase (.env.local = staging, .env.cabinet.local = cabinet) and refuses to
// deploy a bundle that carries the other one. A bare `opennextjs-cloudflare
// build` reads .env.local and would point the cabinet at staging. Secrets
// (SUPABASE_SERVICE_ROLE_KEY, OLLAMA_API_KEY) go in `wrangler secret put --env <env>`.
// Bindings and vars are NOT inherited by environments: redeclare them in each.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "staffd",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // workers.dev stays on (it is the staging URL, behind Cloudflare Access).
  // Per-version preview URLs are separate hostnames that an Access rule on the
  // main hostname does not cover: keep them off.
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "OLLAMA_MODEL": "gpt-oss:120b",
    "OLLAMA_HOST": "https://ollama.com"
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "OLLAMA_MODEL": "gpt-oss:120b",
        "OLLAMA_HOST": "https://ollama.com"
      }
    },
    "cabinet": {
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "OLLAMA_MODEL": "gpt-oss:120b",
        "OLLAMA_HOST": "https://ollama.com"
      }
    }
  }
}
